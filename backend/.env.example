# MemoMate (忆伴) backend configuration (all optional — defaults shown).
#
# >>> THIS FILE NOW SHIPS THE CALIBRATED VALUES <<<
# 融合权重 0.2/0.8 与阈值 0.409/0.521 是在 322 名被试上交叉拟合得到的
# （见 scripts/eval_fusion.py 与 README「已训练模型」）。
# models/ 与 data/ 不入库（.gitignore），获取方式见 README「模型产物共享」。
# 直接复制即可复现文档所述的配置：
#   cp .env.example .env
#   uvicorn auragba.main:app --env-file .env --reload --port 8000

# --- Trained dual-stream models ----------------------------------------------
# Empty = fall back to the interpretable hand-weighted logistic model.
# Loading these requires: pip install opensmile faster-whisper jieba lightgbm scikit-learn joblib
# If a path is set but the model fails to load, the engine logs [auragba][WARN]
# and stamps LOAD-FAILED into the score label + audit fingerprint (never silent).
AURA_ACOUSTIC_MODEL=./models/acoustic_lgbm.txt
AURA_SEMANTIC_MODEL=./models/semantic_lr.joblib

# Local Whisper weights dir (or a model size name like "tiny"); empty ASR means
# no transcript -> the semantic stream is skipped entirely.
AURA_WHISPER_MODEL=./models/whisper-small

# Privacy pipeline mode: "extract-and-burn" (default) discards raw audio right
# after feature extraction and never persists it; "vector-only" assumes the
# device already sent features and keeps no audio at all.
AURA_PRIVACY_MODE=extract-and-burn

# Personal-baseline window, in days (robust-Z anomaly detection).
AURA_BASELINE_DAYS=14
# Day keys and weekly boundaries use this zone; a UTC server must not shift them.
AURA_TIMEZONE=Asia/Hong_Kong

# Longer window for the trend slope and CUSUM change-point detection.
AURA_TREND_DAYS=28

# Late-fusion weights for the dual-stream risk index (auto-normalised).
# CALIBRATED on 322 subjects (eval_fusion.py weight sweep: acoustic stream is the
# weaker one, so it is down-weighted). config.py defaults match these values.
AURA_FUSION_W_ACOUSTIC=0.2
AURA_FUSION_W_SEMANTIC=0.8

# Three-stream initial prior (DEV.md C1), used only when the behaviour stream is
# present. Weights are renormalised over the streams that exist; with behaviour
# absent the two values above apply unchanged (historical results reproducible).
AURA_FUSION3_W_ACOUSTIC=0.15
AURA_FUSION3_W_SEMANTIC=0.65
AURA_FUSION3_W_BEHAVIOR=0.20

# Risk index cut-points for the "watch" and "elevated" bands (0..1).
# CALIBRATED: watch = 40th pct of the control group, elevated = 65th pct
# -> screening-oriented trade-off (sensitivity 0.863 / specificity 0.396).
# config.py defaults match these values.
AURA_RISK_WATCH=0.409
AURA_RISK_ELEVATED=0.521
# 部署患病率假设，仅用于 PPV/NPV 沟通（不是模型测出来的性质）。
# 留空 = 任何界面/报告都不输出 PPV 数字；填 0.10 表示"假设患病率 10%"。
# AURA_DEPLOY_PREVALENCE=0.10

# Pseudonymous store (SQLite WAL) / audit-log directory (no real identifiers).
AURA_DATA_DIR=./.data

# Demo notification provider: family outbox is always written; if this URL is
# set, a coarse {kind, deviceId, recipients} envelope is POSTed to it.
AURA_NOTIFY_WEBHOOK=
# C5: community caregiver is always logged as a demo recipient; set this URL to
# also POST a coarse {kind, deviceId, role:"community"} envelope.
AURA_COMMUNITY_WEBHOOK=

# Signed-session key. MUST be at least 32 bytes; the server refuses to start
# without it. Generate your own for anything beyond local development:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AURA_AUTH_SECRET=dev-only-change-me-please-generate-32-bytes-min

# Cookie policy. Set AURA_COOKIE_SECURE=true together with HTTPS in production.
AURA_COOKIE_SECURE=false

# AES-GCM key for conversation text at rest (>=32 chars; the server refuses to
# boot without it). Replace with a KMS-managed secret outside local development.
AURA_ENCRYPTION_KEY=dev-only-encryption-key-change-me-0123456789
AURA_CONVERSATION_TTL_DAYS=90

# Regulatory claim level: observation (default) or triage_support.
# "diagnostic" is rejected — this build has no regulatory clearance for it.
AURA_REGULATORY_CLAIM_LEVEL=observation

# Comma-separated CORS origins allowed to call this API (the PWA / Android shell).
# Wildcards are rejected because session cookies require an exact origin.
AURA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://localhost

# --- Optional LLM orchestration (OpenAI-compatible) --------------------------
# Disabled by default: /assistant/chat, /agent/cards and /medication/plan keep
# returning 501 and the frontend uses its local card/reminder fallback.
# Enable only after deciding on data-processing consent and a provider.
AURA_LLM_ENABLED=false
AURA_LLM_BASE_URL=https://api.deepseek.com/v1
AURA_LLM_API_KEY=
AURA_LLM_MODEL=deepseek-chat
AURA_LLM_TIMEOUT_S=6
AURA_LLM_TURN_TIMEOUT_S=6
AURA_LLM_MAX_TOKENS=400
# 推理模型（GLM-4.5+/4.7-Flash 等）默认先输出隐藏推理，会把 token 预算吃光并返回空 content；
# 语音回合等不起，设 true 发送 thinking={"type":"disabled"}。DeepSeek 等非推理模型保持 false。
AURA_LLM_DISABLE_THINKING=false
AURA_LLM_DAILY_QUOTA=200

# --- Real weather (Open-Meteo, no API key) -----------------------------------
AURA_WEATHER_ENABLED=true
AURA_WEATHER_TTL_S=600