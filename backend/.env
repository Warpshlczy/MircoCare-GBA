# AuraGBA 本地运行配置（训练好的模型 + ASR 设置）
# 启动方式：uvicorn auragba.main:app --env-file .env --reload --port 8000

# 真实数据训练的双流模型（scripts/train_*.py 产出）
AURA_ACOUSTIC_MODEL=./models/acoustic_lgbm.txt
AURA_SEMANTIC_MODEL=./models/semantic_lr.joblib

# ASR：本地 whisper-small（HF 缓存在本机软链接会坏，已直接落到 models/whisper-small）
AURA_WHISPER_MODEL=./models/whisper-small

# 其它保持默认
AURA_PRIVACY_MODE=extract-and-burn
AURA_BASELINE_DAYS=14
# 融合权重与阈值：scripts/eval_fusion.py 在 322 人上交叉拟合校准得出
# （声学流单流 AUC 0.616，语义流 0.708，校准融合 0.717）
AURA_FUSION_W_ACOUSTIC=0.2
AURA_FUSION_W_SEMANTIC=0.8
# 筛查偏向高敏感度：以对照组 p40 / p65 定界（敏感度约 0.86）
AURA_RISK_WATCH=0.409
AURA_RISK_ELEVATED=0.521
AURA_DATA_DIR=./.data
AURA_CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000,https://localhost

# 本地开发用签名密钥（>=32 字节）。生产请重新生成并只放在部署环境的密钥管理中。
AURA_AUTH_SECRET=auragba-local-dev-7f3c9a1b5e2d4c8f9a0b6d3e1c7f2a5b
AURA_COOKIE_SECURE=false

# 本地开发用会话记忆加密密钥（>=32 字节）。生产请换成 KMS 托管的密钥。
AURA_ENCRYPTION_KEY=auragba-local-enc-9d2f4b6a8c1e3f5a7b9d0c2e4f6a8b1c
AURA_CONVERSATION_TTL_DAYS=90

# 云端 LLM（DeepSeek，OpenAI-compatible）。空 Key 会返回 503，前端自动兜底。
# 填入 Key 后重启：uvicorn auragba.main:app --env-file .env --port 8000
AURA_LLM_ENABLED=true
AURA_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AURA_LLM_API_KEY=469e478474984314acf23a021aa19d30.oAThjh86deq1wJH9
AURA_LLM_MODEL=glm-4-flash
AURA_LLM_DISABLE_THINKING=true
AURA_LLM_TIMEOUT_S=6
AURA_LLM_MAX_TOKENS=400
AURA_LLM_DAILY_QUOTA=200

# 真实天气（Open-Meteo，无需 Key）
AURA_WEATHER_ENABLED=true
AURA_WEATHER_TTL_S=600
