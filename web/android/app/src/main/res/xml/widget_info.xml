<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 cell footprint (110dp ≈ 2 cells on a 5-column launcher).
     updatePeriodMillis is a safety net only: the real refresh path is JS calling
     native.updateHomeWidget(), which pushes immediately via AppWidgetManager. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_home"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
