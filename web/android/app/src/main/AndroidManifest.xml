<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- req 2: listens for the wake name while backgrounded / screen locked -->
        <service
            android:name=".WakeListenService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- W3: 2x2 home-screen widget (待办 3 条 + SOS 热区).
             exported=false is the AppWidget template: AppWidgetService calls the
             provider directly, the intent-filter only exists for the framework. -->
        <receiver
            android:name=".HomeWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- W3: daily alarm -> notification. Fired by our own PendingIntent. -->
        <receiver
            android:name=".DailyAlarmReceiver"
            android:exported="false" />

        <!-- One-shot alarm from `set_alarm`. exported=false: only our own
             PendingIntent is meant to reach it. -->
        <receiver
            android:name=".OnceAlarmReceiver"
            android:exported="false" />

        <!-- W3: re-arm the alarm after reboot. Must be exported=true: the system
             broadcast comes from another UID, so exported=false would drop it. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- voice-first UI: the WebView's getUserMedia + SpeechRecognition need the mic -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- the "影相" camera card -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- haptic confirmation on reminder/sos (navigator.vibrate) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- background wake word: WakeListenService is a foreground mic service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- W3 native layer. Each one is declared in docs/dev.md §3.6 with the
         degraded behaviour when the senior refuses it. -->
    <!-- re-arm the daily alarm after a reboot (BootReceiver) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- exact daily alarm; if revoked on API 31+ we fall back to an inexact one -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- foreground-only geofence; NO background location, ever -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
</manifest>
